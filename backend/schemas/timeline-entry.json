{
  "kind": "collectionType",
  "collectionName": "timelines",
  "info": {
    "singularName": "timeline",
    "pluralName": "timelines",
    "displayName": "Timeline Entry",
    "description": "Orbital trajectory timeline of roles, education, and milestones"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "role": {
      "type": "string",
      "required": true
    },
    "institution": {
      "type": "string",
      "required": true
    },
    "dates": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "education",
        "research",
        "milestone",
        "career"
      ],
      "required": true
    }
  }
}
